{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "laravel-forge",
  "title": "Laravel Forge",
  "description": "View and manage your Laravel Forge-managed servers",
  "icon": "command-icon.png",
  "author": "KevinBatdorf",
  "contributors": [
    "macbookandrew"
  ],
  "license": "MIT",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Manage Servers",
      "subtitle": "Laravel Forge",
      "icon": "command-icon.png",
      "description": "Search and manage your Laravel Forge servers and sites",
      "mode": "view",
      "arguments": [
        {
          "name": "server",
          "placeholder": "Server",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "check-deploy-status",
      "title": "Forge Deployments",
      "description": "Shows sites that are currently being deployed",
      "mode": "menu-bar",
      "interval": "10s"
    }
  ],
  "ai": {
    "instructions": "Every site and server tool takes an id. Get ids from list-sites or list-servers first — nothing searches by name.\nDeployments belong to sites, not servers.\nDeploy failed? deployment-status, then deployment-log.\nSite down or erroring? site-online, then site-config.\nServer problem? server-events.\nOnly deploy, restart or reboot if the user asks.\nEnv file or deploy settings? get-site answers with a Forge link. site-config cannot read them.\nList rows are short. Call probe-api for the field names, then pass the ones you need to list-sites or list-servers in fields.\nPass a cursor object back exactly as it was given to get the next page.\nAlways write a URL as a markdown link: [Deployment settings](url), never a bare URL. Do not open links yourself.",
    "evals": [
      {
        "input": "@laravel-forge does acme-store have zero downtime deploys?",
        "mocks": {
          "list-sites": [
            {
              "id": 5001,
              "name": "acme-store.com",
              "server": "web-1",
              "url": "https://acme-store.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            },
            {
              "id": 5002,
              "name": "acme-blog.com",
              "server": "web-1",
              "url": "https://acme-blog.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            },
            {
              "id": 5003,
              "name": "shop.example.test",
              "server": "web-2",
              "url": "https://shop.example.test",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            }
          ],
          "get-site": {
            "id": 5001,
            "name": "acme-store.com",
            "server": {
              "id": 9001,
              "name": "web-1"
            },
            "url": "https://acme-store.com",
            "status": "installed",
            "phpVersion": "PHP 8.3",
            "zeroDowntimeDeployments": false,
            "isolated": true,
            "repository": {
              "provider": "GitHub",
              "url": "https://github.com/acme/store",
              "branch": "main",
              "status": "installed"
            },
            "quickDeploy": true,
            "deploymentStatus": "finished"
          },
          "probe-api": {
            "target": "site",
            "id": 5001,
            "name": "acme-store.com",
            "links": {
              "site": "https://forge.laravel.com/acme-org/web-1/5001",
              "environment": "https://forge.laravel.com/acme-org/web-1/5001/environment",
              "deploymentSettings": "https://forge.laravel.com/acme-org/web-1/5001/settings/deployments"
            },
            "values": {
              "zero_downtime_deployments": false
            },
            "handling": {}
          }
        },
        "expected": [
          {
            "matches": "(does not|not enabled|not have|disabled|Disabled)"
          }
        ]
      },
      {
        "input": "@laravel-forge what ubuntu version is web-2 on?",
        "mocks": {
          "list-servers": [
            {
              "id": 9001,
              "name": "web-1",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.1",
              "phpVersion": "php83",
              "databaseType": "mysql8",
              "connectionStatus": "successful",
              "isReady": true
            },
            {
              "id": 9002,
              "name": "web-2",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.2",
              "phpVersion": "php84",
              "databaseType": "postgres16",
              "connectionStatus": "successful",
              "isReady": true
            }
          ],
          "get-server": {
            "id": 9002,
            "name": "web-2",
            "provider": "ocean2",
            "region": "nyc1",
            "phpVersion": "php84",
            "databaseType": "postgres16",
            "ubuntuVersion": "22.04",
            "connectionStatus": "successful",
            "isReady": true,
            "sites": [
              "shop.example.test"
            ]
          },
          "probe-api": {
            "target": "server",
            "id": 9002,
            "name": "web-2",
            "links": {
              "server": "https://forge.laravel.com/acme-org/web-2"
            },
            "values": {
              "ubuntu_version": "22.04"
            },
            "handling": {}
          }
        },
        "expected": [
          {
            "includes": "22.04"
          }
        ]
      },
      {
        "input": "@laravel-forge restart the database on web-2",
        "mocks": {
          "list-servers": [
            {
              "id": 9001,
              "name": "web-1",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.1",
              "phpVersion": "php83",
              "databaseType": "mysql8",
              "connectionStatus": "successful",
              "isReady": true
            },
            {
              "id": 9002,
              "name": "web-2",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.2",
              "phpVersion": "php84",
              "databaseType": "postgres16",
              "connectionStatus": "successful",
              "isReady": true
            }
          ],
          "restart-service": {
            "server": "web-2",
            "service": "database",
            "action": "reboot",
            "started": true
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "restart-service",
              "arguments": {
                "service": "database"
              }
            }
          }
        ]
      },
      {
        "input": "@laravel-forge anything deploying?",
        "mocks": {
          "deployment-status": {
            "deploying": [],
            "failed": []
          }
        },
        "expected": [
          {
            "callsTool": "deployment-status"
          },
          {
            "not": {
              "callsTool": "deploy-site"
            }
          }
        ]
      },
      {
        "input": "@laravel-forge deploy acme-store",
        "mocks": {
          "list-sites": [
            {
              "id": 5001,
              "name": "acme-store.com",
              "server": "web-1",
              "url": "https://acme-store.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            },
            {
              "id": 5002,
              "name": "acme-blog.com",
              "server": "web-1",
              "url": "https://acme-blog.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            },
            {
              "id": 5003,
              "name": "shop.example.test",
              "server": "web-2",
              "url": "https://shop.example.test",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            }
          ],
          "deploy-site": {
            "site": "acme-store.com",
            "server": "web-1",
            "started": true
          }
        },
        "expected": [
          {
            "callsTool": "deploy-site"
          }
        ]
      },
      {
        "input": "@laravel-forge show me the env for acme-store",
        "mocks": {
          "list-sites": [
            {
              "id": 5001,
              "name": "acme-store.com",
              "server": "web-1",
              "url": "https://acme-store.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            }
          ],
          "probe-api": {
            "target": "site",
            "id": 5001,
            "name": "acme-store.com",
            "links": {
              "site": "https://forge.laravel.com/acme-org/web-1/5001",
              "environment": "https://forge.laravel.com/acme-org/web-1/5001/environment",
              "deploymentSettings": "https://forge.laravel.com/acme-org/web-1/5001/settings/deployments"
            },
            "values": {},
            "handling": {
              "environment": "Contents not returned. Give the user links.environment as a markdown link to view or edit it in Forge."
            }
          },
          "get-site": {
            "id": 5001,
            "name": "acme-store.com",
            "server": {
              "id": 9001,
              "name": "web-1"
            },
            "status": "installed",
            "phpVersion": "PHP 8.3",
            "zeroDowntimeDeployments": false
          }
        },
        "expected": [
          {
            "callsTool": "probe-api"
          },
          {
            "not": {
              "callsTool": "site-config"
            }
          },
          {
            "matches": "\\[[^\\]]+\\]\\(https://forge\\.laravel\\.com/\\S*/environment\\)"
          }
        ]
      },
      {
        "input": "@laravel-forge show me the deploy script for acme-store",
        "mocks": {
          "list-sites": [
            {
              "id": 5001,
              "name": "acme-store.com",
              "server": "web-1",
              "url": "https://acme-store.com",
              "phpVersion": "PHP 8.3",
              "status": "installed",
              "deploymentStatus": "finished",
              "repository": "acme/store",
              "branch": "main",
              "quickDeploy": true
            }
          ],
          "probe-api": {
            "target": "site",
            "id": 5001,
            "name": "acme-store.com",
            "links": {
              "site": "https://forge.laravel.com/acme-org/web-1/5001",
              "environment": "https://forge.laravel.com/acme-org/web-1/5001/environment",
              "deploymentSettings": "https://forge.laravel.com/acme-org/web-1/5001/settings/deployments"
            },
            "values": {},
            "handling": {
              "deployment_script": "Contents not returned. Give the user links.deploymentSettings as a markdown link to view or edit it in Forge."
            }
          },
          "get-site": {
            "id": 5001,
            "name": "acme-store.com",
            "server": {
              "id": 9001,
              "name": "web-1"
            },
            "status": "installed",
            "phpVersion": "PHP 8.3",
            "zeroDowntimeDeployments": false
          }
        },
        "expected": [
          {
            "callsTool": "probe-api"
          },
          {
            "not": {
              "callsTool": "deployment-log"
            }
          },
          {
            "matches": "\\[[^\\]]+\\]\\(https://forge\\.laravel\\.com/\\S*/settings/deployments\\)"
          }
        ]
      },
      {
        "input": "@laravel-forge what is the ssh public key for web-2?",
        "mocks": {
          "list-servers": [
            {
              "id": 9001,
              "name": "web-1",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.1",
              "phpVersion": "php83",
              "databaseType": "mysql8",
              "connectionStatus": "successful",
              "isReady": true
            },
            {
              "id": 9002,
              "name": "web-2",
              "provider": "ocean2",
              "region": "nyc1",
              "ipAddress": "10.0.0.2",
              "phpVersion": "php84",
              "databaseType": "postgres16",
              "connectionStatus": "successful",
              "isReady": true
            }
          ],
          "get-server": {
            "id": 9002,
            "name": "web-2",
            "provider": "ocean2",
            "region": "nyc1",
            "phpVersion": "php84",
            "ubuntuVersion": "22.04",
            "connectionStatus": "successful",
            "isReady": true,
            "sites": [
              "shop.example.test"
            ]
          },
          "probe-api": {
            "target": "server",
            "id": 9002,
            "name": "web-2",
            "links": {
              "server": "https://forge.laravel.com/acme-org/web-2"
            },
            "values": {
              "local_public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADforge"
            },
            "handling": {}
          }
        },
        "expected": [
          {
            "callsTool": "probe-api"
          },
          {
            "includes": "ssh-rsa"
          }
        ]
      }
    ]
  },
  "tools": [
    {
      "name": "list-orgs",
      "title": "List Organizations",
      "description": "List the Forge organizations your tokens can reach. The other tools use these on their own."
    },
    {
      "name": "list-servers",
      "title": "List Servers",
      "description": "List or filter your Forge servers and get their ids. Start here for anything about a server."
    },
    {
      "name": "list-sites",
      "title": "List Sites",
      "description": "List or search your Forge sites and get their ids. Start here for anything about a site."
    },
    {
      "name": "get-site",
      "title": "Get a Site",
      "description": "Everything Forge knows about one site. Takes a site id from list-sites."
    },
    {
      "name": "get-server",
      "title": "Get a Server",
      "description": "Everything Forge knows about one server, and the sites on it. Takes a server id from list-servers."
    },
    {
      "name": "deployment-status",
      "title": "Check Deployment Status",
      "description": "Which sites are deploying or have failed, across every organization."
    },
    {
      "name": "deployment-history",
      "title": "Get Deployment History",
      "description": "Recent deploys for one site. Takes a site id."
    },
    {
      "name": "deployment-log",
      "title": "Read Deployment Log",
      "description": "The output of one deploy. Takes a site id."
    },
    {
      "name": "server-events",
      "title": "Get Server Events",
      "description": "Recent Forge events for one server, and their output. Takes a server id."
    },
    {
      "name": "site-online",
      "title": "Check If a Site Is Online",
      "description": "Check whether one site answers over HTTP. Takes a site id."
    },
    {
      "name": "site-config",
      "title": "Read Site Config or Logs",
      "description": "Read a site nginx config or log file. Takes a site id."
    },
    {
      "name": "deploy-site",
      "title": "Deploy a Site",
      "description": "Deploy one site now. Takes a site id."
    },
    {
      "name": "restart-service",
      "title": "Restart a Service",
      "description": "Restart, stop or reload a service on one server. Takes a server id."
    },
    {
      "name": "reboot-server",
      "title": "Reboot a Server",
      "description": "Reboot one server. Takes a server id."
    },
    {
      "name": "probe-api",
      "title": "Probe the Forge API",
      "description": "List every field name a site or server has, and what Forge can filter and sort on."
    }
  ],
  "preferences": [
    {
      "name": "laravel_forge_api_token",
      "type": "password",
      "required": true,
      "title": "Forge API Token (v2)",
      "description": "Generate from your Laravel Forge profile",
      "placeholder": "API Token"
    },
    {
      "name": "laravel_forge_ssh_user",
      "type": "textfield",
      "required": false,
      "title": "Laravel Forge SSH User",
      "default": "forge",
      "description": "Change the SSH user to login with",
      "placeholder": "SSH User"
    },
    {
      "name": "laravel_forge_api_token_two",
      "type": "password",
      "required": false,
      "title": "Forge API Token 2 (optional)",
      "description": "Optionally add a second account.",
      "placeholder": "API Token (optional)"
    },
    {
      "name": "laravel_forge_ssh_user_two",
      "type": "textfield",
      "required": false,
      "title": "Laravel Forge SSH User 2 (optional)",
      "default": "forge",
      "description": "Change the SSH user to login with on the second account",
      "placeholder": "SSH User"
    },
    {
      "name": "laravel_forge_ai_protected_values",
      "type": "checkbox",
      "required": false,
      "default": false,
      "title": "AI Access",
      "label": "Let AI read protected values",
      "description": "Allow probe-api to return values it otherwise withholds, like the deploy script and the deploy URL that needs no sign-in."
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.5",
    "date-fns": "^4.4.0",
    "lodash": "^4.17.21",
    "run-applescript": "^7.1.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@raycast/eslint-config": "^2.2.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "eslint": "^9.22.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
